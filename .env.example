# ---- App ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173          # where the browser loads the app (prod: https://yourproduct.com)

# ---- Database (Postgres: Railway / Render / Neon / Supabase) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_starter

# ---- Auth (Better Auth) ----
BETTER_AUTH_SECRET=change-me-to-a-long-random-string   # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:5173
# Optional Google login — leave blank to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# ---- Email (Resend) — leave blank to log emails to the console ----
RESEND_API_KEY=
EMAIL_FROM=Your Product <hello@yourproduct.com>
